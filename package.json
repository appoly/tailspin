{
  "name": "laravel-log-viewer",
  "productName": "Laravel Log Viewer",
  "version": "0.0.10-alpha",
  "main": "dist-electron/main/index.js",
  "license": "MIT",
  "private": true,
  "keywords": [
    "electron",
    "rollup",
    "vite",
    "vue3",
    "vue"
  ],
  "debug": {
    "env": {
      "VITE_DEV_SERVER_URL": "http://127.0.0.1:3344/"
    }
  },
  "scripts": {
    "dev": "vite",
    "pre-build": "vue-tsc --noEmit && vite build",
    "build": "npm run pre-build && electron-builder",
    "build:linux": "npm run pre-build && electron-builder -l --x64",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/bootstrap": "^5.2.6",
    "@types/node-ssh": "^7.0.1",
    "@vitejs/plugin-vue": "^4.2.3",
    "electron": "^25.3.0",
    "electron-builder": "^24.5.2",
    "electron-devtools-installer": "^3.2.0",
    "sass": "^1.63.6",
    "typescript": "^5.1.6",
    "vite": "^4.4.4",
    "vite-plugin-electron": "^0.12.0",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vue": "^3.3.4",
    "vue-tsc": "^1.8.5"
  },
  "dependencies": {
    "@babel/types": "^7.22.5",
    "axios": "^1.4.0",
    "bootstrap": "^5.3.0",
    "bootstrap-icons": "^1.10.5",
    "chokidar": "^3.5.3",
    "drag-drop": "^7.2.0",
    "electron-store": "^8.1.0",
    "fs-extra": "^11.1.1",
    "open": "^9.1.0",
    "pinia": "^2.1.4",
    "ssh2-promise": "^1.0.3",
    "vuedraggable": "^4.1.0"
  }
}
