# Local signed builds only — CI reads the same names from repository secrets.
# Leave everything blank to build unsigned.

# Certificate (.p12) as a base64 string, and its password
CSC_LINK=
CSC_KEY_PASSWORD=

# Which identity in the keychain to sign with, e.g. "Appoly Ltd (TEAMID1234)".
# Optional: electron-builder derives it from CSC_LINK when there is only one.
CSC_NAME=

# Notarization
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=
