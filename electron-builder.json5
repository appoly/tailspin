/**
 * @see https://www.electron.build/configuration/configuration
 */
{
  appId: "com.appoly.tailspin",
  asar: true,
  icon: "public/tailspin.png",
  directories: {
    output: "release",
  },
  files: ["dist-electron", "dist"],
  // Auto-updates read this repo's GitHub releases: CI publishes the installers
  // plus the latest*.yml manifests electron-updater needs. Public repo, so the
  // app needs no token to check.
  //
  // NOTE: this must match the repo name at release time. The repo is being
  // renamed to appoly/tailspin before go-live; if that rename is delayed, put
  // the old name back before tagging, because installed builds keep asking the
  // name they shipped with.
  publish: {
    provider: "github",
    owner: "appoly",
    repo: "tailspin",
  },
  mac: {
    artifactName: "${productName}_${version}_${arch}.${ext}",
    target: [
      { target: "dmg", arch: ["x64", "arm64"] },
      { target: "zip", arch: ["x64", "arm64"] },
    ],
    icon: "build/icon.icns",
    // Signing identity comes from the CSC_NAME env var (or is derived from the
    // certificate in CSC_LINK). Hardcoding it broke `npm run build` for anyone
    // without Appoly's certificate in their keychain.
    hardenedRuntime: true,
    notarize: true,
    entitlements: "build/entitlements.mac.plist",
    entitlementsInherit: "build/entitlements.mac.plist",
    gatekeeperAssess: false,
  },
  win: {
    target: [
      {
        target: "nsis",
        arch: ["x64"],
      },
    ],
    artifactName: "${productName}_${version}.${ext}",
  },
  nsis: {
    oneClick: false,
    perMachine: false,
    allowToChangeInstallationDirectory: true,
    deleteAppDataOnUninstall: false,
  },
  linux: {
    target: ["AppImage"],
    category: "Development",
  },
}
